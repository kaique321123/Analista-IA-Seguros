# Provedor de LLM: gemini | anthropic | openai | mock
LLM_PROVIDER=gemini

# Modelo desejado (opcional; se vazio, usa o padrão de cada provedor)
# Exemplos:
#   gemini:    gemini-flash-lite-latest (rápido e econômico para demos)
#   anthropic: claude-3-5-sonnet-latest
#   openai:    gpt-4o-mini
LLM_MODEL=gemini-flash-lite-latest

# Proteções de custo e latência nas chamadas ao LLM
LLM_MAX_OUTPUT_TOKENS=600
LLM_TIMEOUT_SECONDS=45

# Proteções da interface web pública (4 perguntas totais por visitante/IP + anti-VPN)
LIFETIME_QUESTION_LIMIT=4
QUOTA_SECRET=troque-por-uma-chave-secreta-aleatoria-em-producao
# Opcional: Upstash Redis gratuito (mantém contagem mesmo após hibernação no Render Free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RATE_LIMIT_PER_MINUTE_IP=4
RATE_LIMIT_MAX_REQUESTS=4
RATE_LIMIT_WINDOW_SECONDS=600
GLOBAL_RPM_LIMIT=10
DAILY_REQUEST_CAP=150
MAX_QUESTION_LENGTH=240
MAX_QUESTION_WORDS=45

# Chaves de API (preencha apenas a do provedor escolhido — NUNCA commite o .env)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Caminhos do projeto (padrões relativos à raiz)
DUCKDB_PATH=data/seguros.duckdb
SEMANTIC_LAYER_DIR=semantic_layer

# Limites de segurança
SQL_DEFAULT_LIMIT=100
SQL_MAX_LIMIT=500
